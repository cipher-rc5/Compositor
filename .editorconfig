# Matches the existing sources: four-space indents everywhere a person edits, tabs only where Xcode writes them.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Written by Xcode, which indents these with tabs (the hand-written ExportOptions.plist and entitlements use spaces).
[*.pbxproj]
indent_style = tab

[Config/Info.plist]
indent_style = tab

[*.xcscheme]
indent_size = 3
